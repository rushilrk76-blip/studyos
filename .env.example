# StudyOS Environment Variables
#
# Copy this file to .env.local and fill in your Supabase credentials.
# These are the ONLY two variables needed for cloud features.
#
# Both use NEXT_PUBLIC_ prefix because the browser client needs them.
# These are SAFE to expose — the anon key is designed for frontend use
# and Row Level Security (RLS) protects all data at the database level.
#
# NEVER add the Supabase service_role key here or in any frontend code.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
